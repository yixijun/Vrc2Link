# Copy this file to config.env. Never commit config.env.
PORT=7890
API_KEY=replace-with-a-random-secret
BILIBILI_COOKIE=paste-the-complete-cookie-request-header-here
NETEASE_COOKIE=paste-the-complete-cookie-request-header-here
DOUYIN_COOKIE=paste-the-complete-cookie-request-header-here
KUAISHOU_COOKIE=paste-the-complete-cookie-request-header-here

# Persistent cache and rate-limit counters (Node.js 24 built-in SQLite)
SQLITE_PATH=data/vrc2link.sqlite
CACHE_TTL_SECONDS=300

# Requests allowed in each window
RATE_LIMIT_ANON_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60

# Danmaku polling for Bilibili video and live rooms.
DANMAKU_RATE_LIMIT_PER_MINUTE=90
DANMAKU_SESSION_TTL_SECONDS=21600
DANMAKU_MAX_VIDEO_MESSAGES=300
DANMAKU_MAX_LIVE_MESSAGES=30

# Optional public, non-DRM website resolver powered by yt-dlp.
GENERIC_RESOLVER_ENABLED=false
GENERIC_RESOLVER_REQUIRE_KEY=true
YT_DLP_PATH=yt-dlp
GENERIC_RESOLVER_TIMEOUT_MS=20000
GENERIC_RESOLVER_MAX_CONCURRENT=2
PLAYLIST_RESOLVER_PREFIX=https://vrc2link.luonako.cn/play?url=
PLAYLIST_SESSION_TTL_SECONDS=21600

# Enable only when requests arrive through a trusted reverse proxy
TRUST_PROXY=false
